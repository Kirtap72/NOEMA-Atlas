{
  "name": "noema-atlas",
  "version": "1.0.0",
  "description": "NOEMA Atlas — a local-first visual library for the images that matter.",
  "main": "./out/main/index.js",
  "author": "Patrick Karlsson",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "test:package": "npm run package && node scripts/test-package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/manrope": "^5.2.8",
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.57.0",
    "typescript": "^5.9.3",
    "umap-js": "^1.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "studio.noema.atlas",
    "productName": "NOEMA Atlas",
    "copyright": "Copyright © 2026 Patrick Karlsson",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "extraResources": [
      {
        "from": "build/third-party",
        "to": "third-party"
      },
      {
        "from": "LICENSE",
        "to": "NOEMA-Atlas-LICENSE.txt"
      },
      {
        "from": "reference",
        "to": "reference"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "NOEMA-Atlas-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "NOEMA-Atlas-${version}-portable.${ext}"
    }
  }
}
